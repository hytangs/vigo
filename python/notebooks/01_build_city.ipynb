   "source": [
    "# Build a City\n",
    "\n",
    "Build one complete City directly from GTFS and OSM.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "acae54e37e7d407bbb7b55eff062a284",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "import vigo\n",
    "\n",
    "city = vigo.build(\n",
    "    \"./city\",\n",
    "    gtfs=[os.environ[\"VIGO_GTFS\"]],\n",
    "    osm=os.environ[\"VIGO_OSM\"],\n",
    ")\n",
    "print(city.name, city.revision_id, city.built_at)\n",
    "city.close()"
   ]
  }
 ],
