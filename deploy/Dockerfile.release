# Release jobs supply the already verified Ubuntu-built executable and notices.
# Match the build runner's glibc; the source-build Dockerfile remains self-contained.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
COPY temp/container/vigo /vigo
COPY temp/container/THIRD-PARTY-NOTICES.txt /THIRD-PARTY-NOTICES.txt
COPY LICENSE NOTICE /
USER 65532:65532
ENV VIGO_CITY=/city PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=65s --retries=3 CMD ["/vigo", "health"]
ENTRYPOINT ["/vigo"]
CMD ["serve", "--host", "0.0.0.0"]
